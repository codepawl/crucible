{
  "name": "@codepawlhq/crucible-roblox-import",
  "version": "0.1.0",
  "description": "Companion package that imports Roblox-style scenes exported from Roblox Studio (XML place and model files) as a Crucible scene recipe. Imports no dependency. Not part of the core archive.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./node": "./node.mjs"
  },
  "files": [
    "index.mjs",
    "node.mjs",
    "README.md"
  ],
  "keywords": [
    "roblox",
    "rbxlx",
    "rbxmx",
    "importer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codepawl/crucible.git",
    "directory": "packages/roblox-import"
  },
  "peerDependencies": {
    "@codepawlhq/crucible": ">=0.19.0 <1.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
